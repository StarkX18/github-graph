<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sid.github-graph</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/sid/Desktop/building_stuff/github-graph/backend/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sid/Desktop/building_stuff/github-graph/backend</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/github-graph.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/github-graph.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>3001</string>
  </dict>
</dict>
</plist>
